<?xml version="1.0" encoding="utf-8"?>
<!-- 03. Hadiah harian (popup) (portrait 720x1280) — dibangkitkan dari Design/d4, jangan disunting tangan.
     ID inventaris: A06 C01 C02 C03 C04 C05 C06
     Catatan: Terbuka sendiri saat masuk pertama di hari baru; setelah ditutup bisa dibuka lagi dari ikon Hadiah. Hari 1–3 sudah diambil, hari 4 siap, hari berikutnya menampilkan sisa hari. Hari 7 lebih besar. -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="../Styles/DeliveryDash.uss" />
    <ui:VisualElement name="layar" class="sc sc--p" picking-mode="Ignore">
        <!-- dunia: digambar kamera game, bukan UI (acuan: a-w-lobi-p) -->
        <ui:VisualElement name="@grup-1" class="sc-abs sc-row" style="left: 20px; top: 20px; align-items: center" picking-mode="Ignore">
            <ui:VisualElement name="coins" class="dd-coins" picking-mode="Ignore">
                <ui:VisualElement name="ikon-coin" class="dd-coins__icon ikon ikon--i-coin" picking-mode="Ignore" />
                <ui:Label name="teks" text="312" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="@chip:box" class="ml-12" picking-mode="Ignore">
                <ui:VisualElement name="chip:box" class="dd-chip" picking-mode="Ignore">
                    <ui:VisualElement name="ikon-box" class="dd-chip__icon ikon ikon--i-box" picking-mode="Ignore" />
                    <ui:Label name="teks" text="27" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="@grup-2" class="sc-abs sc-row" style="right: 20px; top: 20px" picking-mode="Ignore">
            <ui:VisualElement name="iconbtn:help" class="dd-iconbtn">
                <ui:VisualElement name="ikon-help" class="dd-iconbtn__glyph ikon ikon--i-help" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="@iconbtn:gear" class="ml-12" picking-mode="Ignore">
                <ui:VisualElement name="iconbtn:gear" class="dd-iconbtn">
                    <ui:VisualElement name="ikon-gear" class="dd-iconbtn__glyph ikon ikon--i-gear" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="logo" class="sc-abs sc-logo logo" style="left: 145px; top: 78px; width: 430px; height: 184px" picking-mode="Ignore" />
        <ui:VisualElement name="@side:garasi" class="sc-abs" style="left: 20px; top: 1040px" picking-mode="Ignore">
            <ui:VisualElement name="side:garasi" class="sc-side" picking-mode="Ignore">
                <ui:VisualElement name="btn" class="sc-side__btn" style="position: relative">
                    <ui:VisualElement name="ikon-garage" class="sc-side__glyph ikon ikon--i-garage" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="label" class="sc-side__label" text="Garasi" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="@side:hadiah" class="sc-abs" style="left: 588px; top: 1040px" picking-mode="Ignore">
            <ui:VisualElement name="side:hadiah" class="sc-side" picking-mode="Ignore">
                <ui:VisualElement name="btn" class="sc-side__btn" style="position: relative">
                    <ui:VisualElement name="ikon-gift" class="sc-side__glyph ikon ikon--i-gift" picking-mode="Ignore" />
                    <ui:VisualElement name="dot" class="sc-dot" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="label" class="sc-side__label" text="Hadiah" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="@modebtn" class="sc-abs" style="left: 152px; top: 992px" picking-mode="Ignore">
            <ui:VisualElement name="modebtn" class="sc-modebtn" style="width: 416px">
                <ui:VisualElement name="thumb" class="sc-bg sc-modebtn__thumb a-mini-kp" picking-mode="Ignore" />
                <ui:VisualElement name="text" class="sc-modebtn__text" picking-mode="Ignore">
                    <ui:Label name="small" class="sc-modebtn__small" text="Kota" picking-mode="Ignore" />
                    <ui:Label name="name" class="sc-modebtn__name" text="Kota Paket" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="ikon-chev" class="sc-modebtn__chev ikon ikon--i-chev" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="@btn:mulai" class="sc-abs" style="left: 152px; top: 1104px" picking-mode="Ignore">
            <ui:VisualElement name="btn:mulai" class="dd-btn dd-btn--reward sc-play" style="width: 416px">
                <ui:VisualElement name="ikon-play" class="dd-btn__icon ikon ikon--i-play" picking-mode="Ignore" />
                <ui:Label name="teks" text="Mulai" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="scrim" class="sc-fill dd-scrim">
            <ui:VisualElement name="dialog:hadiah-harian" class="dd-dialog" style="position: relative; width: 640px" picking-mode="Ignore">
                <ui:VisualElement name="close" class="sc-close" picking-mode="Ignore">
                    <ui:VisualElement name="iconbtn:close" class="dd-iconbtn dd-iconbtn--close">
                        <ui:VisualElement name="ikon-close" class="dd-iconbtn__glyph ikon ikon--i-close" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="title" class="dd-dialog__title" text="Hadiah harian" picking-mode="Ignore" />
                <ui:VisualElement name="days-1" class="sc-days" style="margin-top: 22px; justify-content: center" picking-mode="Ignore">
                    <ui:VisualElement name="day:1" class="sc-day sc-day--sm is-claimed" style="position: relative; margin-right: 10px; margin-bottom: 14px" picking-mode="Ignore">
                        <ui:Label name="name" class="sc-day__name" text="Hari 1" picking-mode="Ignore" />
                        <ui:VisualElement name="ikon-coin" class="sc-day__coin ikon ikon--i-coin" picking-mode="Ignore" />
                        <ui:Label name="amount" class="sc-day__amount" text="10" picking-mode="Ignore" />
                        <ui:Label name="state" class="sc-day__state" text="Diambil" picking-mode="Ignore" />
                        <ui:VisualElement name="done" class="sc-day__done" picking-mode="Ignore">
                            <ui:VisualElement name="ikon-check" class="dd-chip__icon ikon ikon--i-check" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="day:2" class="sc-day sc-day--sm is-claimed" style="position: relative; margin-right: 10px; margin-bottom: 14px" picking-mode="Ignore">
                        <ui:Label name="name" class="sc-day__name" text="Hari 2" picking-mode="Ignore" />
                        <ui:VisualElement name="ikon-coin" class="sc-day__coin ikon ikon--i-coin" picking-mode="Ignore" />
                        <ui:Label name="amount" class="sc-day__amount" text="12" picking-mode="Ignore" />
                        <ui:Label name="state" class="sc-day__state" text="Diambil" picking-mode="Ignore" />
                        <ui:VisualElement name="done" class="sc-day__done" picking-mode="Ignore">
                            <ui:VisualElement name="ikon-check" class="dd-chip__icon ikon ikon--i-check" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="day:3" class="sc-day sc-day--sm is-claimed" style="position: relative; margin-right: 10px; margin-bottom: 14px" picking-mode="Ignore">
                        <ui:Label name="name" class="sc-day__name" text="Hari 3" picking-mode="Ignore" />
                        <ui:VisualElement name="ikon-coin" class="sc-day__coin ikon ikon--i-coin" picking-mode="Ignore" />
                        <ui:Label name="amount" class="sc-day__amount" text="15" picking-mode="Ignore" />
                        <ui:Label name="state" class="sc-day__state" text="Diambil" picking-mode="Ignore" />
                        <ui:VisualElement name="done" class="sc-day__done" picking-mode="Ignore">
                            <ui:VisualElement name="ikon-check" class="dd-chip__icon ikon ikon--i-check" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="day:4" class="sc-day sc-day--sm is-ready" style="position: relative; margin-right: 0px; margin-bottom: 14px" picking-mode="Ignore">
                        <ui:Label name="name" class="sc-day__name" text="Hari 4" picking-mode="Ignore" />
                        <ui:VisualElement name="ikon-coin" class="sc-day__coin ikon ikon--i-coin" picking-mode="Ignore" />
                        <ui:Label name="amount" class="sc-day__amount" text="18" picking-mode="Ignore" />
                        <ui:Label name="state" class="sc-day__state" text="Siap!" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="days-2" class="sc-days" style="justify-content: center" picking-mode="Ignore">
                    <ui:VisualElement name="day:5" class="sc-day sc-day--sm is-next" style="position: relative; margin-right: 10px; margin-bottom: 14px" picking-mode="Ignore">
                        <ui:Label name="name" class="sc-day__name" text="Hari 5" picking-mode="Ignore" />
                        <ui:VisualElement name="ikon-coin" class="sc-day__coin ikon ikon--i-coin" picking-mode="Ignore" />
                        <ui:Label name="amount" class="sc-day__amount" text="20" picking-mode="Ignore" />
                        <ui:Label name="state" class="sc-day__state" text="1 hari lagi" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="day:6" class="sc-day sc-day--sm is-next" style="position: relative; margin-right: 10px; margin-bottom: 14px" picking-mode="Ignore">
                        <ui:Label name="name" class="sc-day__name" text="Hari 6" picking-mode="Ignore" />
                        <ui:VisualElement name="ikon-coin" class="sc-day__coin ikon ikon--i-coin" picking-mode="Ignore" />
                        <ui:Label name="amount" class="sc-day__amount" text="25" picking-mode="Ignore" />
                        <ui:Label name="state" class="sc-day__state" text="2 hari lagi" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="day:7" class="sc-day sc-day--sm sc-day--big" style="position: relative; margin-right: 0px; margin-bottom: 14px" picking-mode="Ignore">
                        <ui:Label name="name" class="sc-day__name" text="Hari 7" picking-mode="Ignore" />
                        <ui:VisualElement name="ikon-gift" class="sc-day__coin ikon ikon--i-gift" picking-mode="Ignore" />
                        <ui:Label name="amount" class="sc-day__amount" text="35" picking-mode="Ignore" />
                        <ui:Label name="state" class="sc-day__state" text="3 hari lagi" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="btn:ambil-koin" class="dd-btn dd-btn--reward" style="min-width: 320px; margin-top: 8px">
                    <ui:VisualElement name="ikon-coin" class="dd-btn__icon ikon ikon--i-coin" picking-mode="Ignore" />
                    <ui:Label name="teks" text="Ambil 18 koin" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="body" class="sc-body sc-muted mt-12" style="-unity-text-align: upper-center" text="Lewat sehari, mulai lagi dari hari 1." picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
