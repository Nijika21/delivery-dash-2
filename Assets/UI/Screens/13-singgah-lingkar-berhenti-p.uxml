<?xml version="1.0" encoding="utf-8"?>
<!-- 13. Singgah (lingkar berhenti) (portrait 720x1280) — dibangkitkan dari Design/d4, jangan disunting tangan.
     ID inventaris: H04 H10 D08
     Catatan: Lingkar di dunia terisi saat truk diam. Tombol kecil mengganti arah petunjuk ke rumah. -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="../Styles/DeliveryDash.uss" />
    <ui:VisualElement name="layar" class="sc sc--p" picking-mode="Ignore">
        <!-- dunia: digambar kamera game, bukan UI (acuan: a-w-singgah-p) -->
        <ui:VisualElement name="lingkar-berhenti" class="sc-fill runtime runtime--lingkar-berhenti" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0" picking-mode="Ignore" tooltip="Lingkar progres berhenti di sekitar truk (dunia). Gambar dengan Painter2D: jari-jari 1,7 unit, tebal 12 px, putih 75% lalu hijau #3F8F3E dari jam 12 searah jarum jam." />
        <ui:VisualElement name="@hudbar" class="sc-abs" style="left: 20px; top: 20px; width: 596px" picking-mode="Ignore">
            <ui:VisualElement name="hudbar" class="dd-hudbar" style="width: 100%" picking-mode="Ignore">
                <ui:VisualElement name="hud-dest" class="sc-bg sc-hud-dest a-zona-singgah" picking-mode="Ignore" />
                <ui:Label name="text" class="dd-hudbar__text" text="Singgah di Jalan Raya Timur" picking-mode="Ignore" />
                <ui:Label name="dist" class="dd-hudbar__dist" text="0 m" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="@iconbtn:pause" class="sc-abs" style="right: 20px; top: 16px" picking-mode="Ignore">
            <ui:VisualElement name="iconbtn:pause" class="dd-iconbtn">
                <ui:VisualElement name="ikon-pause" class="dd-iconbtn__glyph ikon ikon--i-pause" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="@chips" class="sc-abs" style="left: 20px; top: 104px" picking-mode="Ignore">
            <ui:VisualElement name="chips" class="sc-chips" picking-mode="Ignore">
                <ui:VisualElement name="coins" class="dd-coins" picking-mode="Ignore">
                    <ui:VisualElement name="ikon-coin" class="dd-coins__icon ikon ikon--i-coin" picking-mode="Ignore" />
                    <ui:Label name="teks" text="312" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="chip:rest" class="dd-chip dd-chip--help" picking-mode="Ignore">
                    <ui:VisualElement name="ikon-rest" class="dd-chip__icon ikon ikon--i-rest" picking-mode="Ignore" />
                    <ui:Label name="teks" text="Berhenti" picking-mode="Ignore" />
                    <ui:Label name="dwell" class="sc-dwell" text="65%" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="btn:arahkan-ke-rumah" class="dd-btn dd-btn--quiet dd-btn--small" style="margin-top: 4px">
                    <ui:VisualElement name="ikon-house" class="dd-btn__icon ikon ikon--i-house" picking-mode="Ignore" />
                    <ui:Label name="teks" text="Arahkan ke rumah" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="mini" class="sc-mini" style="right: 20px; top: 104px; width: 188px; height: 191px">
            <ui:VisualElement name="map" class="sc-mini__map sc-bg a-mini-kp" style="left: -560.9px; top: -386.9px; width: 960px; height: 960px" picking-mode="Ignore" />
            <ui:VisualElement name="peta-overlay" class="sc-mini__overlay runtime runtime--peta-overlay" picking-mode="Ignore" tooltip="Digambar saat berjalan: titik rute, penanda tujuan, dan panah truk di atas gambar minimap (DeliveryMinimap)." />
            <ui:VisualElement name="hint" class="sc-mini__hint" picking-mode="Ignore">
                <ui:VisualElement name="ikon-expand" class="sc-mini__hint-glyph ikon ikon--i-expand" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="@msg" class="sc-abs sc-row" style="left: 20px; right: 20px; top: 312px; justify-content: center; align-items: center" picking-mode="Ignore">
            <ui:VisualElement name="msg" class="dd-msg" picking-mode="Ignore">
                <ui:VisualElement name="badge" class="dd-msg__badge" picking-mode="Ignore">
                    <ui:VisualElement name="ikon-info" class="dd-msg__glyph ikon ikon--i-info" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="teks" text="Bonus +5: berhenti di lingkaran Jalan Raya Timur sampai penuh, lalu antar paket." picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
