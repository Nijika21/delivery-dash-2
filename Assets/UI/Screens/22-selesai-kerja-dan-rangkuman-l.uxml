<?xml version="1.0" encoding="utf-8"?>
<!-- 22. Selesai kerja dan rangkuman (landscape 1280x720) — dibangkitkan dari Design/d4, jangan disunting tangan.
     ID inventaris: J05 J06 G06 M10
     Catatan: Rangkuman sesi baru: paket, koin, bintang. -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="../Styles/DeliveryDash.uss" />
    <ui:VisualElement name="layar" class="sc sc--l" picking-mode="Ignore">
        <!-- dunia: digambar kamera game, bukan UI (acuan: a-w-selesai-l) -->
        <ui:VisualElement name="@hudbar" class="sc-abs" style="left: 24px; top: 20px; width: 600px" picking-mode="Ignore">
            <ui:VisualElement name="hudbar" class="dd-hudbar" style="width: 100%" picking-mode="Ignore">
                <ui:VisualElement name="ikon-park" class="sc-hud-dest ikon ikon--i-park" picking-mode="Ignore" />
                <ui:Label name="text" class="dd-hudbar__text" text="Parkir selesai kerja" picking-mode="Ignore" />
                <ui:Label name="dist" class="dd-hudbar__dist" text="0 m" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="@coins" class="sc-abs" style="right: 196px; top: 28px" picking-mode="Ignore">
            <ui:VisualElement name="coins" class="dd-coins" picking-mode="Ignore">
                <ui:VisualElement name="ikon-coin" class="dd-coins__icon ikon ikon--i-coin" picking-mode="Ignore" />
                <ui:Label name="teks" text="312" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="@iconbtn:map" class="sc-abs" style="right: 108px; top: 20px" picking-mode="Ignore">
            <ui:VisualElement name="iconbtn:map" class="dd-iconbtn is-on">
                <ui:VisualElement name="ikon-map" class="dd-iconbtn__glyph ikon ikon--i-map" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="@iconbtn:pause" class="sc-abs" style="right: 24px; top: 20px" picking-mode="Ignore">
            <ui:VisualElement name="iconbtn:pause" class="dd-iconbtn">
                <ui:VisualElement name="ikon-pause" class="dd-iconbtn__glyph ikon ikon--i-pause" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="mini" class="sc-mini" style="right: 24px; top: 112px; width: 232px; height: 235px">
            <ui:VisualElement name="map" class="sc-mini__map sc-bg a-mini-kp" style="left: -178.3px; top: -379.9px; width: 960px; height: 960px" picking-mode="Ignore" />
            <ui:VisualElement name="peta-overlay" class="sc-mini__overlay runtime runtime--peta-overlay" picking-mode="Ignore" tooltip="Digambar saat berjalan: titik rute, penanda tujuan, dan panah truk di atas gambar minimap (DeliveryMinimap)." />
            <ui:VisualElement name="hint" class="sc-mini__hint" picking-mode="Ignore">
                <ui:VisualElement name="ikon-expand" class="sc-mini__hint-glyph ikon ikon--i-expand" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="ctl:left" class="sc-abs sc-ctl" style="left: 24px; bottom: 24px">
            <ui:VisualElement name="ikon-left" class="sc-ctl__glyph ikon ikon--i-left" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="ctl:right" class="sc-abs sc-ctl" style="left: 160px; bottom: 24px">
            <ui:VisualElement name="ikon-right" class="sc-ctl__glyph ikon ikon--i-right" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="ctl:rem" class="sc-abs sc-ctl sc-ctl--rem" style="right: 172px; bottom: 24px">
            <ui:VisualElement name="ikon-rem" class="sc-ctl__glyph ikon ikon--i-rem" picking-mode="Ignore" />
            <ui:Label name="label" class="sc-ctl__label" text="REM" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="ctl:gas" class="sc-abs sc-ctl sc-ctl--gas" style="right: 24px; bottom: 24px">
            <ui:VisualElement name="ikon-gas" class="sc-ctl__glyph ikon ikon--i-gas" picking-mode="Ignore" />
            <ui:Label name="label" class="sc-ctl__label" text="GAS" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="scrim" class="sc-fill dd-scrim">
            <ui:VisualElement name="dialog:selesai-kerja" class="dd-dialog dd-dialog--wide" picking-mode="Ignore">
                <ui:Label name="title" class="dd-dialog__title" text="Selesai kerja?" picking-mode="Ignore" />
                <ui:VisualElement name="summary" class="sc-summary" picking-mode="Ignore">
                    <ui:VisualElement name="stat:box" class="sc-stat" picking-mode="Ignore">
                        <ui:VisualElement name="ikon-box" class="sc-stat__icon ikon ikon--i-box" picking-mode="Ignore" />
                        <ui:Label name="num" class="sc-stat__num" text="6" picking-mode="Ignore" />
                        <ui:Label name="label" class="sc-stat__label" text="paket diantar" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="stat:coin" class="sc-stat" picking-mode="Ignore">
                        <ui:VisualElement name="ikon-coin" class="sc-stat__icon ikon ikon--i-coin" picking-mode="Ignore" />
                        <ui:Label name="num" class="sc-stat__num" text="+84" picking-mode="Ignore" />
                        <ui:Label name="label" class="sc-stat__label" text="koin didapat" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="stat:star" class="sc-stat" picking-mode="Ignore">
                        <ui:VisualElement name="ikon-star" class="sc-stat__icon ikon ikon--i-star" picking-mode="Ignore" />
                        <ui:Label name="num" class="sc-stat__num" text="9" picking-mode="Ignore" />
                        <ui:Label name="label" class="sc-stat__label" text="bintang" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="text" class="dd-dialog__text" text="Ya: kembali ke lobby. Tidak: lanjut dari halaman gudang." picking-mode="Ignore" />
                <ui:VisualElement name="actions" class="dd-dialog__actions" picking-mode="Ignore">
                    <ui:VisualElement name="btn:tidak" class="dd-btn dd-btn--quiet">
                        <ui:Label name="teks" text="Tidak" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="btn:ya-ke-lobby" class="dd-btn dd-btn--success">
                        <ui:VisualElement name="ikon-check" class="dd-btn__icon ikon ikon--i-check" picking-mode="Ignore" />
                        <ui:Label name="teks" text="Ya, ke lobby" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
