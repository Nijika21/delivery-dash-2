<?xml version="1.0" encoding="utf-8"?>
<!-- 18. Peta besar (portrait 720x1280) — dibangkitkan dari Design/d4, jangan disunting tangan.
     ID inventaris: D05 E04 E05 E07 E12
     Catatan: Peta seluruh kota dengan legenda. Permainan berhenti selama terbuka. -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="../Styles/DeliveryDash.uss" />
    <ui:VisualElement name="layar" class="sc sc--p" picking-mode="Ignore">
        <!-- dunia: digambar kamera game, bukan UI (acuan: a-w-antar-p) -->
        <ui:VisualElement name="@hudbar" class="sc-abs" style="left: 20px; top: 20px; width: 596px" picking-mode="Ignore">
            <ui:VisualElement name="hudbar" class="dd-hudbar" style="width: 100%" picking-mode="Ignore">
                <ui:VisualElement name="ikon-house" class="sc-hud-dest ikon ikon--i-house" picking-mode="Ignore" />
                <ui:Label name="text" class="dd-hudbar__text" text="Jalan Puncak 1" picking-mode="Ignore" />
                <ui:Label name="dist" class="dd-hudbar__dist" text="110 m" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="@iconbtn:pause" class="sc-abs" style="right: 20px; top: 16px" picking-mode="Ignore">
            <ui:VisualElement name="iconbtn:pause" class="dd-iconbtn">
                <ui:VisualElement name="ikon-pause" class="dd-iconbtn__glyph ikon ikon--i-pause" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="@chips" class="sc-abs" style="left: 20px; top: 104px" picking-mode="Ignore">
            <ui:VisualElement name="chips" class="sc-chips" picking-mode="Ignore">
                <ui:VisualElement name="coins" class="dd-coins" picking-mode="Ignore">
                    <ui:VisualElement name="ikon-coin" class="dd-coins__icon ikon ikon--i-coin" picking-mode="Ignore" />
                    <ui:Label name="teks" text="312" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="chip:bantuan" class="dd-chip dd-chip--help" picking-mode="Ignore">
                    <ui:VisualElement name="icon" class="sc-bg dd-chip__icon a-zona-bantuan" picking-mode="Ignore" />
                    <ui:Label name="teks" text="Bantuan 1/3" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="chip:star" class="dd-chip dd-chip--star" picking-mode="Ignore">
                    <ui:VisualElement name="ikon-star" class="dd-chip__icon ikon ikon--i-star" picking-mode="Ignore" />
                    <ui:Label name="teks" text="Bintang 1/3" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="mini" class="sc-mini" style="right: 20px; top: 104px; width: 188px; height: 191px">
            <ui:VisualElement name="map" class="sc-mini__map sc-bg a-mini-kp" style="left: -141.4px; top: -471.0px; width: 960px; height: 960px" picking-mode="Ignore" />
            <ui:VisualElement name="peta-overlay" class="sc-mini__overlay runtime runtime--peta-overlay" picking-mode="Ignore" tooltip="Digambar saat berjalan: titik rute, penanda tujuan, dan panah truk di atas gambar minimap (DeliveryMinimap)." />
            <ui:VisualElement name="hint" class="sc-mini__hint" picking-mode="Ignore">
                <ui:VisualElement name="ikon-expand" class="sc-mini__hint-glyph ikon ikon--i-expand" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="@msg" class="sc-abs sc-row" style="left: 20px; right: 20px; top: 312px; justify-content: center; align-items: center" picking-mode="Ignore">
            <ui:VisualElement name="msg" class="dd-msg" picking-mode="Ignore">
                <ui:VisualElement name="badge" class="dd-msg__badge" picking-mode="Ignore">
                    <ui:VisualElement name="ikon-info" class="dd-msg__glyph ikon ikon--i-info" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="teks" text="Paket siap! Ikuti petunjuk menuju rumah." picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="joy" class="sc-abs sc-joy" style="left: 92px; top: 922px" picking-mode="Ignore">
            <ui:VisualElement name="knob" class="sc-joy__knob" style="left: 35px; top: 85px" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="dim" class="sc-fill sc-dim" picking-mode="Ignore" />
        <ui:VisualElement name="bigmap" class="sc-abs sc-bigmap" style="left: 20px; top: 60px; width: 680px; height: 1160px; padding: 20px; flex-direction: column" picking-mode="Ignore">
            <ui:VisualElement name="@grup-1" class="sc-row" style="margin-bottom: 14px" picking-mode="Ignore">
                <ui:Label name="title" class="sc-title sc-grow" style="font-size: 36px" text="Peta kota" picking-mode="Ignore" />
                <ui:VisualElement name="iconbtn:close" class="dd-iconbtn dd-iconbtn--close">
                    <ui:VisualElement name="ikon-close" class="dd-iconbtn__glyph ikon ikon--i-close" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="map" class="sc-bigmap__map a-mini-kp" style="width: 634px; height: 634px" picking-mode="Ignore">
                <ui:VisualElement name="peta-overlay" class="sc-mini__overlay runtime runtime--peta-overlay" picking-mode="Ignore" tooltip="Digambar saat berjalan: titik rute, penanda tujuan, dan panah truk di atas gambar minimap (DeliveryMinimap)." />
            </ui:VisualElement>
            <ui:VisualElement name="@grup-2" class="sc-row" style="align-items: flex-start; margin-top: 4px" picking-mode="Ignore">
                <ui:VisualElement name="legend-1" class="sc-legend" picking-mode="Ignore">
                    <ui:VisualElement name="row-1" class="sc-legend__row" picking-mode="Ignore">
                        <ui:VisualElement name="panah-truk" class="sc-legend__icon ikon ikon--truk-panah" style="rotate: -90deg" picking-mode="Ignore" />
                        <ui:Label name="teks" text="Truk kamu" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="row-2" class="sc-legend__row" picking-mode="Ignore">
                        <ui:VisualElement name="ikon-house" class="sc-legend__icon ikon ikon--i-house" picking-mode="Ignore" />
                        <ui:Label name="teks" text="Rumah tujuan" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="row-3" class="sc-legend__row" picking-mode="Ignore">
                        <ui:VisualElement name="ikon-box" class="sc-legend__icon ikon ikon--i-box" picking-mode="Ignore" />
                        <ui:Label name="teks" text="Gudang paket" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="jarak" style="width: 24px" picking-mode="Ignore" />
                <ui:VisualElement name="legend-2" class="sc-legend" picking-mode="Ignore">
                    <ui:VisualElement name="row-1" class="sc-legend__row" picking-mode="Ignore">
                        <ui:VisualElement name="ikon-bang" class="sc-legend__icon ikon ikon--i-bang" picking-mode="Ignore" />
                        <ui:Label name="teks" text="Bantuan warga" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="row-2" class="sc-legend__row" picking-mode="Ignore">
                        <ui:VisualElement name="ikon-park" class="sc-legend__icon ikon ikon--i-park" picking-mode="Ignore" />
                        <ui:Label name="teks" text="Parkir selesai" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="body" class="sc-body mt-16" text="Permainan berhenti selama peta terbuka." picking-mode="Ignore" />
            <ui:VisualElement name="jarak" class="sc-grow" picking-mode="Ignore" />
            <ui:VisualElement name="btn:tutup-peta" class="dd-btn dd-btn--quiet">
                <ui:VisualElement name="ikon-close" class="dd-btn__icon ikon ikon--i-close" picking-mode="Ignore" />
                <ui:Label name="teks" text="Tutup peta" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
