<?xml version="1.0" encoding="utf-8"?>
<!-- 02. Lobby (landscape 1280x720) — dibangkitkan dari Design/d4, jangan disunting tangan.
     ID inventaris: A01 A02 A03 A04 A05 A07 A11
     Catatan: Satu tombol utama: Mulai (paling besar, di jangkauan jempol kanan/bawah). Kota aktif tampil di atas Mulai dan membuka Pilih kota. Garasi dan Hadiah jadi ikon; titik merah = hadiah hari ini belum diambil. Tombol ? membuka cerita game; ikon gerigi membuka Pengaturan. Latar: depot Kota Paket dan truk dengan skin terpasang. -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="../Styles/DeliveryDash.uss" />
    <ui:VisualElement name="layar" class="sc sc--l" picking-mode="Ignore">
        <!-- dunia: digambar kamera game, bukan UI (acuan: a-w-lobi-l) -->
        <ui:VisualElement name="logo" class="sc-abs sc-logo logo" style="left: 24px; top: 14px; width: 400px; height: 171px" picking-mode="Ignore" />
        <ui:VisualElement name="@grup-1" class="sc-abs sc-row" style="right: 24px; top: 20px; align-items: center" picking-mode="Ignore">
            <ui:VisualElement name="chip:box" class="dd-chip" picking-mode="Ignore">
                <ui:VisualElement name="ikon-box" class="dd-chip__icon ikon ikon--i-box" picking-mode="Ignore" />
                <ui:Label name="teks" text="27" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="@coins" class="ml-12" picking-mode="Ignore">
                <ui:VisualElement name="coins" class="dd-coins" picking-mode="Ignore">
                    <ui:VisualElement name="ikon-coin" class="dd-coins__icon ikon ikon--i-coin" picking-mode="Ignore" />
                    <ui:Label name="teks" text="312" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="@iconbtn:help" class="ml-16" picking-mode="Ignore">
                <ui:VisualElement name="iconbtn:help" class="dd-iconbtn">
                    <ui:VisualElement name="ikon-help" class="dd-iconbtn__glyph ikon ikon--i-help" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="@iconbtn:gear" class="ml-12" picking-mode="Ignore">
                <ui:VisualElement name="iconbtn:gear" class="dd-iconbtn">
                    <ui:VisualElement name="ikon-gear" class="dd-iconbtn__glyph ikon ikon--i-gear" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="@grup-2" class="sc-abs" style="left: 24px; top: 226px" picking-mode="Ignore">
            <ui:VisualElement name="side:garasi" class="sc-side" picking-mode="Ignore">
                <ui:VisualElement name="btn" class="sc-side__btn" style="position: relative">
                    <ui:VisualElement name="ikon-garage" class="sc-side__glyph ikon ikon--i-garage" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="label" class="sc-side__label" text="Garasi" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="jarak" class="mt-16" picking-mode="Ignore" />
            <ui:VisualElement name="side:hadiah" class="sc-side" picking-mode="Ignore">
                <ui:VisualElement name="btn" class="sc-side__btn" style="position: relative">
                    <ui:VisualElement name="ikon-gift" class="sc-side__glyph ikon ikon--i-gift" picking-mode="Ignore" />
                    <ui:VisualElement name="dot" class="sc-dot" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="label" class="sc-side__label" text="Hadiah" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="@modebtn" class="sc-abs" style="right: 24px; bottom: 148px" picking-mode="Ignore">
            <ui:VisualElement name="modebtn" class="sc-modebtn" style="width: 320px">
                <ui:VisualElement name="thumb" class="sc-bg sc-modebtn__thumb a-mini-kp" picking-mode="Ignore" />
                <ui:VisualElement name="text" class="sc-modebtn__text" picking-mode="Ignore">
                    <ui:Label name="small" class="sc-modebtn__small" text="Kota" picking-mode="Ignore" />
                    <ui:Label name="name" class="sc-modebtn__name" text="Kota Paket" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="ikon-chev" class="sc-modebtn__chev ikon ikon--i-chev" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="@btn:mulai" class="sc-abs" style="right: 24px; bottom: 28px" picking-mode="Ignore">
            <ui:VisualElement name="btn:mulai" class="dd-btn dd-btn--reward sc-play" style="width: 320px">
                <ui:VisualElement name="ikon-play" class="dd-btn__icon ikon ikon--i-play" picking-mode="Ignore" />
                <ui:Label name="teks" text="Mulai" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
